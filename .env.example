# Client endpoints embedded into the Next.js build.
# Replace localhost with the Docker/LAN host when other devices connect.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

NEXT_ALLOWED_DEV_ORIGINS=local.beatsync.gg,10.0.0.*,192.168.100.*

# Exact browser origins allowed to call the Bun HTTP and WebSocket server.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Storage mode: "local" requires no S3-compatible service.
STORAGE_MODE=local
LOCAL_STORAGE_PATH=./data
LOCAL_PUBLIC_URL=http://localhost:8080

# Required only when STORAGE_MODE=s3.
S3_BUCKET_NAME=
S3_PUBLIC_URL=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional integrations.
NEXT_PUBLIC_POSTHOG_KEY=
PROVIDER_URL=
CREATOR_SECRET=

# Optional demo mode.
NEXT_PUBLIC_DEMO_MODE=0
DEMO=0
DEMO_ADMIN_SECRET=beatsync
DEMO_AUDIO_DIR=./demo-audio
